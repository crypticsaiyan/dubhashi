   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2142178960,
   "version": 1,
   "versionNonce": 170426852,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763190000000,
   "link": null,
   "locked": false,
   "text": "- Hold to talk: Prisma gives no partial transcripts and free keys allow one request at a time. Also no echo, mic only sends while held.\n- One STT socket per press: avoids the 15 min session limit and idle timeouts. Audio buffered until open, then drained at 2x.\n- Number guard in code: an LLM can silently change a dose. A plain digit check catches it even if the LLM reports nothing.\n- Video never carries sound: listeners hear only the interpreter, never the original and the translation on top of each other.\n- Providers behind interfaces: MOCK_AI=1 runs the whole app with fake speech and translation, so tests need no API keys.",
   "originalText": "- Hold to talk: Prisma gives no partial transcripts and free keys allow one request at a time. Also no echo, mic only sends while held.\n- One STT socket per press: avoids the 15 min session limit and idle timeouts. Audio buffered until open, then drained at 2x.\n- Number guard in code: an LLM can silently change a dose. A plain digit check catches it even if the LLM reports nothing.\n- Video never carries sound: listeners hear only the interpreter, never the original and the translation on top of each other.\n- Providers behind interfaces: MOCK_AI=1 runs the whole app with fake speech and translation, so tests need no API keys.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  }
 ],
