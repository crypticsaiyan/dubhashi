# Gnani API key from https://app.gnani.ai/voice/api-keys
GNANI_API_KEY=

# Any OpenAI-compatible provider serving an open-weights model.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it

# Timbre model. Falls back to timbre-v2.5 voices if v3.0 is rejected.
TTS_MODEL=timbre-v3.0

PORT=8787

# Run with fake speech and translation, no keys needed. The UI shows a banner.
# MOCK_AI=1

# Video uses peer-to-peer WebRTC. Public STUN is enough on most networks.
# Some mobile carriers need a TURN relay; add one as a JSON array:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Behind a proxy every visitor shares its IP, so name the header the proxy
# sets with the real one. Render and Cloudflare: true-client-ip.
# CLIENT_IP_HEADER=true-client-ip
