  { "language": "pa-IN", "to": "ta-IN", "text": "ਤੁਸੀਂ ਕਿਵੇਂ ਹੋ, ਘਰ ਵਿੱਚ ਸਭ ਠੀਕ ਹੈ?", "numbers": [] },
